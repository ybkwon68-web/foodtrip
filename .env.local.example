# 이 파일을 .env.local로 복사하고 실제 값을 채워넣으세요. (.env.local은 .gitignore에 있어 커밋되지 않습니다)

# Supabase 프로젝트 설정 > API 에서 확인
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_키_붙여넣기

# 편집 모드 진입 비밀번호 (본인이 직접 정하기)
ADMIN_PASSWORD=여기에_원하는_비밀번호

# 관리자 세션 토큰 서명용 비밀키 (아무 임의의 긴 문자열, 예: openssl rand -hex 32)
SESSION_SECRET=여기에_임의의_긴_문자열

# 로그인 시도 rate limit용 Upstash Redis (Upstash 콘솔 > 해당 DB > REST API 에서 확인, 미설정 시 rate limit 비활성)
UPSTASH_REDIS_REST_URL=여기에_Upstash_REST_URL
UPSTASH_REDIS_REST_TOKEN=여기에_Upstash_REST_TOKEN

# 식당 주소 저장 시 자동 좌표 조회용 네이버 Geocoding API (NCP 콘솔 > 해당 애플리케이션 > Geocoding 체크 > 인증키 관리 에서 확인, 미설정 시 좌표 자동조회 비활성)
NAVER_GEOCODE_CLIENT_ID=여기에_Geocoding용_Client_ID
NAVER_GEOCODE_CLIENT_SECRET=여기에_Geocoding용_Client_Secret
